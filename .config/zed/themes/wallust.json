      "style": {
        "background": "#1A1A22",
        "text": "#D7E4EA",
        "text.muted": "#ACB6BB",
        "text.placeholder": "#97A0A4",
        "text.disabled": "#81898C",
        "text.accent": "#3D9ECB",

        "icon": "#D7E4EA",
