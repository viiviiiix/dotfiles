            "color": "#D7E4EA"
          },
          "variable.special": {
            "color": "#8EA5D3"
          },

          "property": {
            "color": "#3D9ECB"
          },
          "attribute": {
            "color": "#7787AB"
          },

          "operator": {
            "color": "#8DB3C4"
          },

          "punctuation": {
            "color": "#C2CDD3"
          },
          "punctuation.bracket": {
            "color": "#D7E4EA"
          },
          "punctuation.delimiter": {
            "color": "#C2CDD3"
          },

          "tag": {
            "color": "#538D9F"
          },

          "label": {
            "color": "#3D9ECB"
          },

          "text.literal": {
            "color": "#328BC9"
          },

          "title": {
            "color": "#3D9ECB",
            "font_weight": 700
          },

          "link_text": {
            "color": "#3D9ECB",
            "font_style": "italic"
          },
          "link_uri": {
            "color": "#8DB3C4"
          },

