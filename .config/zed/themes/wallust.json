        "border.focused": "#3D9ECB",
        "border.selected": "#3D9ECB",
        "border.transparent": "#00000000",
        "border.disabled": "#2B2E2F",

        "surface.background": "#1A1A22",
        "elevated_surface.background": "#313138",

        "element.background": "transparent",
