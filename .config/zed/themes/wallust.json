            "color": "#7787AB"
          },
          "constant": {
            "color": "#7787AB"
          },
          "boolean": {
            "color": "#8EA5D3"
          },

          "function": {
            "color": "#3D9ECB"
          },
          "constructor": {
            "color": "#3D9ECB"
          },

          "type": {
            "color": "#8EA5D3"
          },
          "enum": {
            "color": "#8EA5D3"
          },

